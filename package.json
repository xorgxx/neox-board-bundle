{
  "private": true,
  "scripts": {
    "build": "npm run build:css && npm run build:js",
    "build:css": "tailwindcss -i assets/tailwind.css -o src/Resources/public/neox-board.css --minify",
    "build:js": "esbuild assets/app.js --bundle --minify --outfile=src/Resources/public/neox-board.js",
    "test:js": "node --test tests/js/*.test.cjs"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.0",
    "esbuild": "^0.25.0",
    "jsdom": "^31.0.0",
    "tailwindcss": "^4.1.0"
  },
  "dependencies": {
    "@hotwired/stimulus": "^3.2.2",
    "@hotwired/turbo": "^8.0.12",
    "preline": "^5.0.0"
  }
}
