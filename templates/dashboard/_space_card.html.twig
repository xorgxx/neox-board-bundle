<article class="space-card" data-space-order-id="{{ space.id }}" data-space-column-index="{{ space.columnIndex }}" data-controller="space-collapse{% if query|default('') is empty %} reorder{% endif %}" {% if query|default('') is empty %}data-reorder-url-value="{{ path('neox_board_space_reorder',{id:space.id}) }}" data-reorder-token-value="{{ csrf_token('space_reorder_'~space.id) }}" data-reorder-space-value="{{ space.id }}" data-reorder-check-url-value="{{ path('neox_board_link_drop_check',{id:space.id}) }}" data-reorder-token-url-value="{{ path('neox_board_link_drop_token',{id:space.id}) }}" data-reorder-create-url-value="{{ path('neox_board_link_drop',{id:space.id}) }}" data-reorder-create-token-value="{{ csrf_token('link_new_'~space.id) }}" data-action="dragover->space-collapse#expand dragover->reorder#overContainer drop->reorder#dropOnContainer{% if panel|default('overview') in ['overview','spaces'] %} dragover->space-order#overSpace drop->space-order#dropSpace{% endif %}"{% endif %}><div class="space-head">{% if query|default('') is empty and panel|default('overview') in ['overview','spaces'] %}<button class="space-drag-handle" type="button" draggable="true" data-action="dragstart->space-order#startSpace dragend->space-order#endSpace pointerdown->space-order#touchStart pointermove->space-order#touchMove pointerup->space-order#touchEnd pointercancel->space-order#touchCancel contextmenu->space-order#touchContextMenu keydown->space-order#moveByKeyboard" aria-label="Déplacer l’espace {{ space.title }}" aria-keyshortcuts="Alt+ArrowUp Alt+ArrowDown Alt+ArrowLeft Alt+ArrowRight" title="Déplacer l’espace (Alt + ↑/↓)"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="8" cy="6" r="1.4"/><circle cx="16" cy="6" r="1.4"/><circle cx="8" cy="12" r="1.4"/><circle cx="16" cy="12" r="1.4"/><circle cx="8" cy="18" r="1.4"/><circle cx="16" cy="18" r="1.4"/></svg></button>{% endif %}<span class="space-icon">{{ space.icon|default('▱') }}</span><div class="space-title"><h3>{{ space.title }}</h3><p>{{ space.description }}</p></div>{% set item_count = space.links|length + space.sections|length + space.widgets|length %}<span class="space-count" aria-label="{{ item_count }} élément{{ item_count == 1 ? '' : 's' }}">{{ item_count }} <span>{{ item_count == 1 ? 'élément' : 'éléments' }}</span></span><form method="post" data-turbo-stream action="{{ path('neox_board_space_favorite',{id:space.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('space_favorite_'~space.id) }}"><button class="favorite {{ space.favorite|default(false) ? 'selected' : '' }}" aria-label="Basculer favori">★</button></form><div class="space-actions"><a class="space-action" title="Ajouter un lien" aria-label="Ajouter un lien" data-turbo-frame="neox_board_modal" href="{{ path('neox_board_link_new',{id:space.id}) }}"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg><span class="sr-only">Ajouter un lien</span></a><a class="space-action" title="Section" aria-label="Section" data-turbo-frame="neox_board_modal" href="{{ path('neox_board_section_new',{id:space.id}) }}"><svg aria-hidden="true" viewBox="0 0 24 24"><rect x="4" y="5" width="16" height="14" rx="2"/><path d="M4 10h16"/></svg><span class="sr-only">Section</span></a><a class="space-action" title="Widget" aria-label="Widget" data-turbo-frame="neox_board_modal" href="{{ path('neox_board_widget_new',{id:space.id}) }}"><svg aria-hidden="true" viewBox="0 0 24 24"><rect x="4" y="4" width="6" height="6" rx="1"/><rect x="14" y="4" width="6" height="6" rx="1"/><rect x="4" y="14" width="6" height="6" rx="1"/><rect x="14" y="14" width="6" height="6" rx="1"/></svg><span class="sr-only">Widget</span></a><a class="space-action" title="Modifier" aria-label="Modifier" data-turbo-frame="neox_board_modal" href="{{ path('neox_board_space_edit',{id:space.id}) }}"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="m4 16-.8 4.8L8 20l11.4-11.4a2.1 2.1 0 0 0-3-3L5 17"/><path d="m14.5 6.5 3 3"/></svg><span class="sr-only">Modifier</span></a><form method="post" data-turbo-stream action="{{ path('neox_board_space_delete',{id:space.id}) }}" data-turbo-confirm="Supprimer cet espace et ses liens ?"><input type="hidden" name="_token" value="{{ csrf_token('space_delete_'~space.id) }}"><button class="space-action" type="submit" title="Supprimer" aria-label="Supprimer"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M4 7h16M10 11v6m4-6v6M6 7l1 13h10l1-13M9 7V4h6v3"/></svg><span class="sr-only">Supprimer</span></button></form></div><button class="space-collapse-toggle" type="button" data-space-collapse-target="toggle" data-action="space-collapse#toggle" aria-expanded="true" aria-label="Replier cet espace" title="Replier cet espace"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></button></div><div class="space-card-content" id="space-content-{{ space.id }}" data-space-collapse-target="content" data-controller="section-tabs">
        <div class="drop-link-preview" data-reorder-target="dropPreview" hidden aria-live="polite"><span class="drop-link-preview-icon" aria-hidden="true">↗</span><div class="drop-link-preview-content"><span class="drop-link-preview-eyebrow">APERÇU DU <span data-reorder-target="previewKind">LIEN</span> · <span data-reorder-target="previewSection"></span></span><b data-reorder-target="previewTitle"></b><code data-reorder-target="previewUrl"></code><ul class="drop-link-preview-items" data-reorder-target="previewItems" hidden></ul><p data-reorder-target="previewMessage" data-state="checking">Vérification de l’URL…</p></div><div class="drop-link-preview-actions"><button class="drop-link-cancel" type="button" data-action="reorder#cancelPreview">Annuler</button><button class="drop-link-confirm" type="button" data-reorder-target="confirmButton" data-action="reorder#confirmDroppedLink" disabled>Ajouter</button></div></div>
        {% if space.widgets|length %}<div class="section-list"><b>Widgets</b>{% for widget in space.widgets %}<div>{{ widget.title }} <small>({{ widget.type }})</small><a data-turbo-frame="neox_board_modal" href="{{ path('neox_board_widget_edit',{id:widget.id}) }}" aria-label="Modifier le widget">✎</a><form method="post" data-turbo-stream action="{{ path('neox_board_widget_delete',{id:widget.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('widget_delete_'~widget.id) }}"><button type="submit" aria-label="Supprimer le widget">×</button></form></div>{% endfor %}</div>{% endif %}<ul class="link-list">
          {% if item_count == 0 %}<li class="space-empty-message">Cet espace est vide. Ajoutez un lien, une section ou un widget.</li>{% endif %}
          {% for entry in menu_items[space.id]|default([]) %}
            {% if entry.type == 'section' and (query|default('') is empty or space.id in search_space_ids|default([])) %}
              {% set section = entry.item %}<li class="section-divider" data-section-id="{{ section.id }}" data-menu-item="section:{{ section.id }}" {% if query|default('') is empty %}draggable="true" tabindex="0" aria-keyshortcuts="Alt+ArrowUp Alt+ArrowDown" data-action="dragstart->reorder#start dragover->reorder#over drop->reorder#drop dragend->reorder#end keydown->reorder#moveByKeyboard"{% endif %}><div class="section-divider-label"><span>{{ section.title }}</span></div><div class="section-divider-actions"><a data-turbo-frame="neox_board_modal" href="{{ path('neox_board_section_edit',{id:section.id}) }}" aria-label="Modifier la section {{ section.title }}" title="Modifier"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m14 5 5 5M4 20l4.2-.8L19 8.4a2.1 2.1 0 0 0-3-3L5.2 16.2 4 20Z"/></svg></a><form method="post" data-turbo-stream action="{{ path('neox_board_section_delete',{id:section.id}) }}" data-turbo-confirm="Supprimer cette section ?"><input type="hidden" name="_token" value="{{ csrf_token('section_delete_'~section.id) }}"><button type="submit" aria-label="Supprimer la section {{ section.title }}" title="Supprimer"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M10 11v6m4-6v6M6 7l1 13h10l1-13M9 7V4h6v3"/></svg></button></form></div></li>
            {% else %}
            {% set link = entry.item %}{% if query|default('') is empty or space.id in search_space_ids|default([]) or link.id in search_link_ids|default([]) %}
              <li class="link-row" data-link-id="{{ link.id }}" data-menu-item="link:{{ link.id }}" {% if query|default('') is empty %}draggable="true" tabindex="0" aria-keyshortcuts="Alt+ArrowUp Alt+ArrowDown" data-action="dragstart->reorder#start dragover->reorder#over drop->reorder#drop dragend->reorder#end keydown->reorder#moveByKeyboard"{% endif %}>
                <a class="resource-link" href="{{ link.browserInternalUrl ? '#browser-internal' : path('neox_board_link_open',{id:link.id}) }}" title="{{ link.url }}" {% if link.browserInternalUrl %}data-action="click->browser-link#open" data-browser-url="{{ link.url }}"{% endif %} target="_blank" rel="noopener noreferrer"><span class="link-icon">{% if link.faviconFilename %}<img src="{{ path('neox_board_link_favicon',{id:link.id}) }}" alt="" loading="lazy" width="18" height="18">{% else %}<b class="link-initial" style="--link-fallback-color:{{ link.fallbackColor }}">{{ link.title|slice(0, 1)|upper }}</b>{% endif %}</span><span class="resource-title">{{ link.title }}</span><span class="external link-availability-arrow {{ link.availabilityStatus is same as(true) ? 'is-active' : (link.availabilityStatus is same as(false) ? 'is-inactive' : 'is-unchecked') }}" data-link-availability-arrow="{{ link.id }}" title="{{ link.availabilityStatus is same as(true) ? 'Lien actif' : (link.availabilityStatus is same as(false) ? 'Lien inaccessible' : 'À vérifier') }}" aria-label="{{ link.availabilityStatus is same as(true) ? 'Lien actif' : (link.availabilityStatus is same as(false) ? 'Lien inaccessible' : 'À vérifier') }}"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M7 17 17 7M8 7h9v9"/></svg></span></a>
                <div class="resource-actions">
                  <a data-turbo-frame="neox_board_modal" href="{{ path('neox_board_link_edit',{id:link.id}) }}" aria-label="Modifier {{ link.title }}" title="Modifier"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="m14 5 5 5M4 20l4.2-.8L19 8.4a2.1 2.1 0 0 0-3-3L5.2 16.2 4 20Z"/><path d="m13 6 5 5"/></svg></a>
                  <form method="post" data-turbo-stream action="{{ path('neox_board_link_favorite',{id:link.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('link_favorite_'~link.id) }}"><button type="submit" aria-label="Basculer le favori" title="Basculer le favori"><svg aria-hidden="true" viewBox="0 0 24 24" class="{{ link.favorite ? 'is-filled' : '' }}"><path d="m12 3 2.8 5.7 6.2.9-4.5 4.4 1.1 6.2-5.6-3-5.6 3 1.1-6.2L3 9.6l6.2-.9L12 3Z"/></svg></button></form>
                  <form method="post" data-turbo-stream action="{{ path('neox_board_link_delete',{id:link.id}) }}" data-turbo-confirm="Supprimer ce lien ?"><input type="hidden" name="_token" value="{{ csrf_token('link_delete_'~link.id) }}"><button type="submit" aria-label="Supprimer {{ link.title }}" title="Supprimer"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M4 7h16M10 11v6m4-6v6M6 7l1 13h10l1-13M9 7V4h6v3"/></svg></button></form>
                </div>
              </li>
            {% endif %}
            {% endif %}
          {% endfor %}
        </ul></div></article>
