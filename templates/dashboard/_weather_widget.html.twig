<section class="dashboard-widget-card weather-widget-card {{ weather_widget_placement.size == 'wide' ? 'is-wide' : 'is-column' }}" aria-labelledby="weather-widget-title" {% if weather_widget_placement.size == 'wide' and weather_widget_placement.position == 'top' %}data-controller="widget-layout" data-widget-layout-url-value="{{ path('neox_board_widgets_weather_layout') }}" data-widget-layout-token-value="{{ csrf_token('widget_weather_layout') }}"{% endif %}>
  <div class="dashboard-widget-heading"><div class="weather-widget-title"><button class="weather-widget-drag-handle" type="button" draggable="true" data-action="dragstart->widget-layout#start dragend->widget-layout#end" aria-label="Déplacer le widget météo" title="Glisser vers une colonne"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="8" cy="6" r="1.4"/><circle cx="16" cy="6" r="1.4"/><circle cx="8" cy="12" r="1.4"/><circle cx="16" cy="12" r="1.4"/><circle cx="8" cy="18" r="1.4"/><circle cx="16" cy="18" r="1.4"/></svg></button><div><p class="eyebrow">WIDGET</p><h2 id="weather-widget-title">Météo · {{ weather_location.name }}</h2></div></div><a href="{{ path('neox_board_widgets') }}" data-turbo-frame="neox_board_main" data-turbo-action="advance">Gérer les widgets</a></div>
  <div class="weather-widget-days">{% for day in weather_forecast.days %}<article class="weather-widget-day"><span>{{ day.label }}</span><span class="weather-widget-icon" aria-hidden="true">{{ day.icon }}</span><b>{{ day.current is not null ? day.current : day.max }}°</b><small>{{ day.min }}° / {{ day.max }}° · {{ day.condition }}</small></article>{% endfor %}</div>
</section>
