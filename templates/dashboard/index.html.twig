<!doctype html>
{% set background = background_settings|default({'mode':'default','color':'#0b1220'}) %}
<html lang="fr" data-theme="dark" data-dashboard-background="{{ background.mode|default('default') }}" style="--dashboard-background-color: {{ background.color|default('#0b1220') }};{% if background.image|default(null) %} --dashboard-background-image: url('{{ path('neox_board_background_image', {filename: background.image}) }}');{% endif %}">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
  {% if app.request.headers.get('Turbo-Frame') and app.request.cookies.get('neox_board_asset') != '202611121956' %}<meta name="turbo-visit-control" content="reload">{% endif %}
  {% if app.request.attributes.get('csp_nonce') %}<meta name="csp-nonce" content="{{ app.request.attributes.get('csp_nonce') }}">{% endif %}
  <title>{{ title|default('Neox Dashboard') }}</title>
  <link rel="icon" type="image/png" href="/favicon.png?v=2">
  <link rel="stylesheet" href="{{ asset('bundles/neoxboard/neox-board.css') }}">
  <link rel="stylesheet" href="{{ asset('bundles/neoxboard/dashboard.css') }}?v=202611121949" data-turbo-track="reload">
  <script defer src="{{ asset('bundles/neoxboard/neox-board.js') }}?v=202611121956" data-turbo-track="reload"></script>
</head>
<body data-controller="theme sidebar browser-link header">
<aside class="sidebar" id="dashboard-sidebar" data-controller="navigation" data-navigation-panel-value="{{ panel|default('overview') }}">
  <div class="sidebar-brand-row"><a class="brand" href="{{ path('neox_board_index') }}"><span class="brand-mark">N</span><span><b>Neox</b><small>Dashboard</small></span></a><button class="sidebar-toggle" type="button" data-sidebar-target="toggle" data-action="sidebar#toggle" aria-expanded="true" aria-label="Replier la barre latérale" title="Replier la barre latérale"><span data-sidebar-icon aria-hidden="true">«</span></button></div>
  <nav aria-label="Navigation principale">
    {% for key, label in {'overview':'Vue d’ensemble','favorites':'Favoris','activity':'Activité','widgets':'Widgets','help':'Aide','settings':'Réglages'} %}
      <a class="nav-link {{ panel|default('overview') == key ? 'active' : '' }}" href="{{ path(key == 'overview' ? 'neox_board_index' : 'neox_board_' ~ key) }}" data-turbo-frame="neox_board_main" data-turbo-action="advance" data-navigation-target="link" data-panel="{{ key }}" data-action="sidebar#closeMobile" {% if panel|default('overview') == key %}aria-current="page"{% endif %}><span class="nav-icon" aria-hidden="true">{{ {'overview':'⌂','spaces':'▱','favorites':'☆','activity':'⌁','widgets':'▦','help':'?','settings':'⚙'}[key] }}</span><span>{{ label }}</span></a>
    {% endfor %}
  </nav>
  <div class="sidebar-foot"><span class="avatar">A</span><span><b>{{ user_name|default('Alex') }}</b><small>Workspace personnel</small></span><span>⌄</span></div>
</aside>
<button class="sidebar-backdrop" type="button" data-action="sidebar#closeMobile" aria-label="Fermer le menu" tabindex="-1" hidden></button>
<main class="main mx-auto max-w-screen-2xl">
  {% if mercure_url|default(null) %}<turbo-stream-source src="{{ mercure_url }}"></turbo-stream-source>{% endif %}
  <div data-controller="modal"><dialog class="board-modal" data-modal-target="dialog" data-action="click->modal#backdrop"><div class="board-modal-panel"><button class="modal-close" type="button" data-action="modal#close" aria-label="Fermer">×</button><turbo-frame id="neox_board_modal" data-action="turbo:frame-load->modal#frameLoaded"></turbo-frame></div></dialog></div><dialog class="browser-link-dialog" data-browser-link-target="dialog" data-action="click->browser-link#backdrop"><section class="browser-link-panel" aria-labelledby="browser-link-title"><button class="modal-close" type="button" data-action="browser-link#close" aria-label="Fermer">×</button><h2 id="browser-link-title">Ouvrir une page interne du navigateur</h2><p>Le navigateur bloque l’ouverture de ses pages de réglages depuis un site. Copie cette adresse et colle-la dans la barre d’adresse.</p><label for="browser-link-url">Adresse</label><input id="browser-link-url" type="text" readonly data-browser-link-target="url"><p class="browser-link-status" role="status" aria-live="polite" data-browser-link-target="status"></p><div class="browser-link-actions"><button class="secondary-button" type="button" data-action="browser-link#close">Fermer</button><button class="primary-button" type="button" data-action="browser-link#copy">Copier l’adresse</button></div></section></dialog>
  <header class="topbar">
    <button class="mobile-menu-toggle" type="button" data-sidebar-target="mobileToggle" data-action="sidebar#toggleMobile" aria-expanded="false" aria-controls="dashboard-sidebar" aria-label="Ouvrir le menu" title="Ouvrir le menu"><svg viewBox="0 0 24 24" aria-hidden="true"><path class="menu-lines" d="M4 6h16M4 12h16M4 18h16"/><path class="menu-close" d="m6 6 12 12M18 6 6 18"/></svg></button>
    <div class="topbar-upper">
      <div class="topbar-meta">
        <div class="topbar-date-copy"><p class="eyebrow topbar-date">{{ date_label|upper }}</p>{% if calendar_observances.saint|default(null) or calendar_observances.events|default([]) is not empty %}<div class="date-observances" aria-label="Saint du jour et événements du calendrier">{% if calendar_observances.saint|default(null) %}<a href="{{ calendar_observances.saint.url }}" target="_blank" rel="noopener noreferrer" title="Saint du jour · Nominis">{{ calendar_observances.saint.name }}</a>{% endif %}{% for event in calendar_observances.events|default([]) %}<a href="{{ event.url }}" target="_blank" rel="noopener noreferrer">{{ event.label }}</a>{% endfor %}</div>{% endif %}</div>
        {% if weather_forecast|default([]).days|default([]) is not empty %}
          <section class="weather-forecast" aria-label="Prévisions météo sur trois jours" title="Données météo : Open-Meteo">
            <div class="weather-days">
              {% for day in weather_forecast.days %}
                <div class="weather-day {{ loop.first ? 'is-today' : '' }}" title="{{ day.condition }} · {{ day.min }}° à {{ day.max }}°">
                  <span class="weather-day-name">{{ day.label }}</span>
                  <span class="weather-day-icon" aria-hidden="true">{{ day.icon }}</span>
                  <b>{{ day.current is not null ? day.current : day.max }}°</b>
                  <small>{{ day.min }}° <span aria-hidden="true">/</span> {{ day.max }}°</small>
                </div>
              {% endfor %}
            </div>
          </section>
        {% endif %}
      </div>
      <div class="topbar-tools">
        <form class="search flex items-center gap-3 rounded-xl bg-white px-4" method="get" action="{{ path('neox_board_index') }}" data-controller="search" data-action="submit->search#submit" data-turbo-frame="neox_board_main" data-turbo-action="advance"><div class="search-engine-switch" role="group" aria-label="Moteur de recherche"><button type="button" data-search-engine="neox" data-action="search#selectEngine" aria-pressed="true">Neox</button><button type="button" data-search-engine="google" data-action="search#selectEngine" aria-pressed="false">Google</button></div><input type="search" name="q" value="{{ query|default('') }}" placeholder="Search link | domain or @d:1, @h:23, @w:2, @m:1" aria-label="Rechercher" data-search-target="input"><kbd>Ctrl K</kbd><button class="search-submit" type="submit" aria-label="Lancer la recherche" title="Rechercher"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.3"/><path d="m16 16 4.2 4.2"/></svg></button></form>
        <button class="theme-toggle" type="button" data-action="theme#toggle" aria-label="Activer le thème sombre" aria-pressed="false" title="Changer de thème"><span data-theme-icon aria-hidden="true">☾</span></button>
        <div class="hs-dropdown relative inline-flex notification-dropdown"><button class="icon-button hs-dropdown-toggle" type="button" aria-label="Notifications récentes" aria-haspopup="true" aria-expanded="false" title="Notifications"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 9a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9M10 21h4"/></svg>{% if activities|default([]) is not empty %}<i aria-hidden="true"></i>{% endif %}</button><div class="hs-dropdown-menu notification-menu hidden absolute right-0 z-20 mt-2 w-80 rounded-xl border border-slate-200 bg-white p-3 shadow-xl"><div class="notification-menu-heading"><b>Activité récente</b><span>{{ activities|default([])|length }}</span></div><ul>{% for item in activities|default([])|slice(0, 5) %}<li><span class="notification-item-icon" aria-hidden="true">{{ item.icon }}</span><span><b>{{ item.title }}</b><time>{{ item.time }}</time></span></li>{% else %}<li class="notification-empty">Aucune activité récente.</li>{% endfor %}</ul><a class="notification-all" href="{{ path('neox_board_activity') }}" data-turbo-frame="neox_board_main" data-turbo-action="advance">Voir toute l’activité <span aria-hidden="true">→</span></a></div></div>
        <div class="hs-dropdown relative inline-flex profile-dropdown"><button class="profile-trigger hs-dropdown-toggle" type="button" aria-label="Ouvrir le menu du compte {{ user_name|default('Alex') }}" aria-haspopup="true" aria-expanded="false" title="Compte"><span class="profile-avatar-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="3.5"/><path d="M5 20c.6-3.2 3-5 7-5s6.4 1.8 7 5"/></svg></span><span class="profile-trigger-name">{{ user_name|default('Alex') }}</span><svg class="profile-trigger-chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="m7 10 5 5 5-5"/></svg></button><div class="hs-dropdown-menu profile-menu hidden absolute right-0 z-20 mt-2 min-w-56 rounded-xl border border-slate-200 bg-white p-3 shadow-xl"><div class="profile-menu-user"><span class="avatar">{{ user_name|default('A')|first|upper }}</span><span><b>{{ user_name|default('Alex') }}</b><small>Compte connecté</small></span></div><a href="{{ path('neox_board_settings') }}" data-turbo-frame="neox_board_main" data-turbo-action="advance"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="m19.4 15 .1.1 1.4 1.1-1.4 2.4-1.7-.7a8 8 0 0 1-1.7 1l-.3 1.8h-2.8l-.3-1.8a8 8 0 0 1-1.7-1l-1.7.7-1.4-2.4 1.4-1.1a7 7 0 0 1 0-2l-1.4-1.1 1.4-2.4 1.7.7a8 8 0 0 1 1.7-1l.3-1.8h2.8l.3 1.8a8 8 0 0 1 1.7 1l1.7-.7 1.4 2.4-1.4 1.1a7 7 0 0 1 0 2Z"/></svg>Réglages</a></div></div>
      </div>
    </div>
  </header>
  <turbo-frame id="neox_board_main">
  <div class="layout">
    <section class="content" aria-label="Tableau de bord">
      {% if panel|default('overview') == 'overview' and weather_widget_enabled|default(false) and weather_forecast.days|default([]) is not empty and weather_widget_placement.size == 'wide' and weather_widget_placement.position == 'top' %}{% include '@NeoxBoard/dashboard/_weather_widget.html.twig' %}{% endif %}
      {% if panel|default('overview') in ['overview','spaces','space','search'] %}<div class="section-heading" id="spaces"><div><p class="eyebrow">{{ panel == 'search' ? 'RÉSULTATS DE RECHERCHE' : (panel == 'space' ? 'ESPACE' : 'VOTRE ORGANISATION') }}</p><h2>{{ panel == 'search' ? 'Recherche : '~query : (panel == 'space' and selected_space ? selected_space.title : 'Mes espaces') }}</h2></div>{% if panel != 'search' %}<a class="primary-button" data-turbo-frame="neox_board_modal" href="{{ path('neox_board_space_new') }}"><span>+</span> Nouvel espace</a>{% endif %}</div>
      <div class="space-grid" {% if query|default('') is empty and panel|default('overview') in ['overview','spaces'] %}data-controller="space-order{% if panel|default('overview') == 'overview' %} widget-layout{% endif %}" data-space-order-url-value="{{ path('neox_board_spaces_reorder') }}" data-space-order-token-value="{{ csrf_token('spaces_reorder') }}"{% if panel|default('overview') == 'overview' %} data-widget-layout-url-value="{{ path('neox_board_widgets_weather_layout') }}" data-widget-layout-token-value="{{ csrf_token('widget_weather_layout') }}" data-action="dragstart->widget-layout#start dragend->widget-layout#end"{% endif %}{% endif %}>
      {% if query|default('') is empty and panel|default('overview') in ['overview','spaces'] %}<p class="sr-only" data-space-order-target="status" aria-live="polite"></p>{% endif %}
      {% if display_spaces is empty %}<div class="empty-state"><span>{{ panel == 'search' ? '⌕' : '▱' }}</span>{% if panel == 'search' %}<h3>Aucun résultat</h3><p>Aucun espace ou lien ne correspond à « {{ query }} ».</p>{% else %}<h3>Votre dashboard est prêt</h3><p>Créez un espace pour commencer à organiser vos liens et widgets.</p><a class="primary-button" data-turbo-frame="neox_board_modal" href="{{ path('neox_board_space_new') }}">+ Créer mon premier espace</a>{% endif %}</div>{% endif %}
      {% if display_spaces is not empty or (panel|default('overview') == 'overview' and weather_widget_enabled|default(false) and weather_widget_placement.size == 'column') %}<div class="space-columns {{ display_spaces|length == 1 ? 'is-single-column' : '' }}">
        <div class="space-column" data-space-column="0" role="group" aria-label="Colonne gauche" data-action="dragover->space-order#overEmptyColumn drop->space-order#dropInEmptyColumn dragover->widget-layout#overColumn drop->widget-layout#dropColumn">
          {% if panel|default('overview') == 'overview' and weather_widget_enabled|default(false) and weather_widget_placement.size == 'column' and weather_widget_placement.column == 0 and weather_widget_placement.position == 'top' and weather_forecast.days|default([]) is not empty %}{% include '@NeoxBoard/dashboard/_weather_widget.html.twig' %}{% endif %}
          {% for space in display_spaces %}{% if space.columnIndex == 0 %}{% include '@NeoxBoard/dashboard/_space_card.html.twig' %}{% endif %}{% endfor %}
          {% if panel|default('overview') == 'overview' and weather_widget_enabled|default(false) and weather_widget_placement.size == 'column' and weather_widget_placement.column == 0 and weather_widget_placement.position == 'bottom' and weather_forecast.days|default([]) is not empty %}{% include '@NeoxBoard/dashboard/_weather_widget.html.twig' %}{% endif %}
        </div>
        <div class="space-column" data-space-column="1" role="group" aria-label="Colonne droite" data-action="dragover->space-order#overEmptyColumn drop->space-order#dropInEmptyColumn dragover->widget-layout#overColumn drop->widget-layout#dropColumn">
          {% if panel|default('overview') == 'overview' and weather_widget_enabled|default(false) and weather_widget_placement.size == 'column' and weather_widget_placement.column == 1 and weather_widget_placement.position == 'top' and weather_forecast.days|default([]) is not empty %}{% include '@NeoxBoard/dashboard/_weather_widget.html.twig' %}{% endif %}
          {% for space in display_spaces %}{% if space.columnIndex == 1 %}{% include '@NeoxBoard/dashboard/_space_card.html.twig' %}{% endif %}{% endfor %}
          {% if panel|default('overview') == 'overview' and weather_widget_enabled|default(false) and weather_widget_placement.size == 'column' and weather_widget_placement.column == 1 and weather_widget_placement.position == 'bottom' and weather_forecast.days|default([]) is not empty %}{% include '@NeoxBoard/dashboard/_weather_widget.html.twig' %}{% endif %}
        </div>
      </div>{% endif %}
      {% if panel|default('overview') == 'overview' and weather_widget_enabled|default(false) and weather_forecast.days|default([]) is not empty and weather_widget_placement.size == 'wide' and weather_widget_placement.position == 'bottom' %}{% include '@NeoxBoard/dashboard/_weather_widget.html.twig' %}{% endif %}
      </div>
      {% endif %}      {% if panel|default('overview') == 'favorites' %}<section class="dashboard-section" id="favorites" aria-labelledby="favorites-title"><div class="section-heading"><div><p class="eyebrow">ACCÈS RAPIDES</p><h2 id="favorites-title">Mes favoris</h2></div></div><div class="favorite-grid">
        {% for space in spaces|default([]) %}
          {% if space.favorite %}<a class="favorite-item" href="{{ path('neox_board_space_view',{spaceId:space.id}) }}" data-turbo-frame="neox_board_main"><span class="favorite-item-icon space-icon" aria-hidden="true">{{ space.icon|default('▱') }}</span><span class="favorite-item-copy"><span class="favorite-type">ESPACE FAVORI</span><b>{{ space.title }}</b><small>Ouvrir cet espace</small></span><span class="favorite-item-arrow" aria-hidden="true">↗</span></a>{% endif %}
          {% for link in space.links|default([]) %}{% if link.favorite %}<a class="favorite-item" href="{{ link.browserInternalUrl ? '#browser-internal' : path('neox_board_link_open',{id:link.id}) }}" {% if link.browserInternalUrl %}data-action="click->browser-link#open" data-browser-url="{{ link.url }}"{% endif %} target="_blank" rel="noopener noreferrer"><span class="favorite-item-icon link-icon" aria-hidden="true">{% if link.faviconFilename %}<img src="{{ path('neox_board_link_favicon',{id:link.id}) }}" alt="" loading="lazy" width="18" height="18">{% else %}<b class="link-initial" style="--link-fallback-color:{{ link.fallbackColor }}">{{ link.title|slice(0, 1)|upper }}</b>{% endif %}</span><span class="favorite-item-copy"><span class="favorite-type">LIEN FAVORI</span><b>{{ link.title }}</b><small>Dans {{ space.title }} · Ouvrir le lien</small></span><span class="favorite-item-arrow" aria-hidden="true">↗</span></a>{% endif %}{% endfor %}
        {% endfor %}
        {% if favorites_count|default(0) == 0 %}<p class="favorites-empty">Aucun favori pour le moment. Utilisez l’étoile sur un espace ou un raccourci pour le retrouver ici.</p>{% endif %}
      </div></section>{% endif %}
{% if panel|default('overview') == 'activity' %}<section class="dashboard-section" aria-labelledby="main-activity-title"><div class="section-heading"><div><p class="eyebrow">JOURNAL</p><h2 id="main-activity-title">Activité récente</h2></div></div><ol class="main-activity-list">{% for item in activities|default([]) %}<li><span>{{ item.icon }}</span><div><b>{{ item.title }}</b><time>{{ item.time }}</time></div></li>{% else %}<li class="activity-empty">Aucune activité récente.</li>{% endfor %}</ol></section>{% endif %}
{% if panel|default('overview') == 'widgets' %}<section class="dashboard-section widgets-manager" aria-labelledby="widgets-manager-title"><div class="section-heading"><div><p class="eyebrow">PERSONNALISATION</p><h2 id="widgets-manager-title">Widgets du tableau</h2><p>Choisissez les cartes qui s’affichent sur votre Vue d’ensemble.</p></div></div><article class="widget-manager-card"><div class="widget-manager-icon" aria-hidden="true">☀</div><div class="widget-manager-copy"><p class="eyebrow">WIDGET MÉTÉO</p><h3>Météo · {{ weather_location.name }}</h3><p>Affiche les prévisions du jour et des deux prochains jours sur votre tableau.</p><span class="widget-manager-status {{ weather_widget_enabled ? 'is-enabled' : '' }}">{{ weather_widget_enabled ? 'Activé sur le tableau' : 'Désactivé' }}</span></div><form method="post" action="{{ path('neox_board_widgets_weather_toggle') }}" data-turbo-stream><input type="hidden" name="_token" value="{{ csrf_token('widget_weather_toggle') }}"><input type="hidden" name="enabled" value="{{ weather_widget_enabled ? '0' : '1' }}"><button class="{{ weather_widget_enabled ? 'secondary-button' : 'primary-button' }}" type="submit">{{ weather_widget_enabled ? 'Désactiver' : 'Activer' }}</button></form></article><form class="widget-layout-form" method="post" action="{{ path('neox_board_widgets_weather_layout') }}" data-turbo-stream><input type="hidden" name="_token" value="{{ csrf_token('widget_weather_layout') }}"><label>Taille<select name="size"><option value="wide" {{ weather_widget_placement.size == 'wide' ? 'selected' : '' }}>Deux colonnes</option><option value="column" {{ weather_widget_placement.size == 'column' ? 'selected' : '' }}>Une colonne</option></select></label><label>Colonne<select name="column"><option value="0" {{ weather_widget_placement.column == 0 ? 'selected' : '' }}>Gauche</option><option value="1" {{ weather_widget_placement.column == 1 ? 'selected' : '' }}>Droite</option></select></label><label>Position<select name="position"><option value="top" {{ weather_widget_placement.position == 'top' ? 'selected' : '' }}>Avant les espaces</option><option value="bottom" {{ weather_widget_placement.position == 'bottom' ? 'selected' : '' }}>Après les espaces</option></select></label><button class="secondary-button" type="submit">Enregistrer la disposition</button></form></section>{% endif %}
      {% if panel|default('overview') == 'help' %}<section class="dashboard-section browser-help-section" aria-labelledby="browser-help-title"><div class="section-heading"><div><p class="eyebrow">GUIDE DU NAVIGATEUR</p><h2 id="browser-help-title">Pages internes et réglages avancés</h2><p>Les navigateurs protègent ces pages et bloquent leur ouverture depuis un site. Copie une adresse, puis colle-la dans la barre du navigateur.</p></div></div><p class="browser-help-notice" role="status" aria-live="polite" data-browser-link-target="notice"></p>{% set browser_shortcuts = {'Firefox':[{'name':'Configuration avancée','url':'about:config'},{'name':'Extensions','url':'about:addons'},{'name':'Informations de dépannage','url':'about:support'}],'Chrome':[{'name':'Paramètres','url':'chrome://settings'},{'name':'Extensions','url':'chrome://extensions'},{'name':'Fonctionnalités expérimentales','url':'chrome://flags'}],'Edge':[{'name':'Paramètres','url':'edge://settings'},{'name':'Extensions','url':'edge://extensions'},{'name':'Fonctionnalités expérimentales','url':'edge://flags'}],'Brave':[{'name':'Paramètres','url':'brave://settings'},{'name':'Extensions','url':'brave://extensions'},{'name':'Fonctionnalités expérimentales','url':'brave://flags'}],'Opera':[{'name':'Paramètres','url':'opera://settings'},{'name':'Extensions','url':'opera://extensions'}],'Vivaldi':[{'name':'Paramètres','url':'vivaldi://settings'},{'name':'Extensions','url':'vivaldi://extensions'}]} %}<div class="browser-help-grid">{% for browser, shortcuts in browser_shortcuts %}<article class="browser-help-card"><h3>{{ browser }}</h3><ul>{% for shortcut in shortcuts %}<li><span><b>{{ shortcut.name }}</b><code>{{ shortcut.url }}</code></span><button type="button" data-action="browser-link#copyShortcut" data-browser-url="{{ shortcut.url }}" aria-label="Copier {{ shortcut.url }}">Copier</button></li>{% endfor %}</ul></article>{% endfor %}</div></section>{% endif %}
      {% if panel|default('overview') == 'settings' %}<section class="dashboard-section settings-section" id="settings" aria-labelledby="settings-title">
        <div><p class="eyebrow">PRÉFÉRENCES</p><h2 id="settings-title">Réglages d’affichage</h2><p>Personnalisez la couleur et le mode d’affichage de votre dashboard. Le choix est mémorisé sur cet appareil.</p>{% for message in app.flashes('background_error') %}<p class="settings-form-error" role="alert">{{ message }}</p>{% endfor %}<form class="settings-background-form" method="post" enctype="multipart/form-data" action="{{ path('neox_board_settings_background') }}"><input type="hidden" name="_token" value="{{ csrf_token('dashboard_background') }}"><fieldset><legend>Arrière-plan du dashboard</legend><div class="background-mode-options"><label><input type="radio" name="background_mode" value="default" {{ background.mode|default('default') == 'default' ? 'checked' : '' }}><span>Thème actuel</span></label><label><input type="radio" name="background_mode" value="color" {{ background.mode|default('default') == 'color' ? 'checked' : '' }}><span>Couleur unie</span></label><label><input type="radio" name="background_mode" value="image" {{ background.mode|default('default') == 'image' ? 'checked' : '' }}><span>Image</span></label></div><label class="background-color-label" for="background-color">Couleur de fond<input id="background-color" name="background_color" type="color" value="{{ background.color|default('#0b1220') }}"></label><label class="background-image-label" for="background-image">Image de fond <small>JPEG, PNG ou WebP · 5 Mo maximum</small></label><input id="background-image" name="background_image" type="file" accept="image/jpeg,image/png,image/webp">{% if background.image|default(null) %}<label class="background-remove-label"><input type="checkbox" name="remove_background_image" value="1"> Supprimer l’image enregistrée</label>{% endif %}<button type="submit" class="background-save-button">Enregistrer l’arrière-plan</button></fieldset></form><fieldset class="settings-colors"><legend>Couleur du thème</legend><div class="settings-color-options"><button type="button" data-color="violet" data-action="theme#chooseColor" aria-label="Thème violet" aria-pressed="true"><span class="color-swatch color-violet"></span><span>Violet</span></button><button type="button" data-color="blue" data-action="theme#chooseColor" aria-label="Thème bleu" aria-pressed="false"><span class="color-swatch color-blue"></span><span>Bleu</span></button><button type="button" data-color="cyan" data-action="theme#chooseColor" aria-label="Thème cyan" aria-pressed="false"><span class="color-swatch color-cyan"></span><span>Cyan</span></button><button type="button" data-color="emerald" data-action="theme#chooseColor" aria-label="Thème émeraude" aria-pressed="false"><span class="color-swatch color-emerald"></span><span>Émeraude</span></button><button type="button" data-color="rose" data-action="theme#chooseColor" aria-label="Thème rose" aria-pressed="false"><span class="color-swatch color-rose"></span><span>Rose</span></button><button type="button" data-color="amber" data-action="theme#chooseColor" aria-label="Thème ambre" aria-pressed="false"><span class="color-swatch color-amber"></span><span>Ambre</span></button></div></fieldset>{% for message in app.flashes('weather_location_error') %}<p class="settings-form-error" role="alert">{{ message }}</p>{% endfor %}<form class="settings-location-form" method="post" action="{{ path('neox_board_settings_weather_location') }}"><input type="hidden" name="_token" value="{{ csrf_token('weather_location') }}"><label for="weather-location">Localisation météo</label><div><input id="weather-location" name="location" type="text" value="{{ weather_location.name }}" placeholder="Lyon, France" minlength="2" maxlength="100" required><button type="submit">Mettre à jour</button></div><small>Entre une ville, éventuellement suivie du pays, pour préciser le résultat.</small></form><form class="settings-link-search" method="get" action="{{ path('neox_board_index') }}" data-turbo-frame="neox_board_main" data-turbo-action="advance"><label for="settings-link-query">Rechercher un lien</label><div><input id="settings-link-query" type="search" name="q" value="{{ query|default('') }}" placeholder="Titre, domaine ou @d:1…"><button type="submit"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.3"/><path d="m16 16 4.2 4.2"/></svg><span>Rechercher</span></button></div></form><form class="settings-favicon-search" method="post" action="{{ path('neox_board_favicons_search') }}"><input type="hidden" name="_token" value="{{ csrf_token('favicon_search') }}"><button type="submit"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.3"/><path d="m16 16 4.2 4.2M10.8 7.8v6M7.8 10.8h6"/></svg><span>Rechercher les favicons manquants</span></button></form><form class="settings-link-check" data-controller="link-check" data-link-check-url-value="{{ path('neox_board_links_check_availability') }}" data-link-check-token-value="{{ csrf_token('links_check_availability') }}" data-action="submit->link-check#check"><button type="submit" data-link-check-target="button"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12.5 9.2 17 20 6"/><circle cx="12" cy="12" r="9"/></svg><span>Vérifier les liens actifs</span></button><p data-link-check-target="status" role="status" aria-live="polite"></p><div data-link-check-target="results" class="settings-link-check-results" aria-live="polite"></div></form></div>
        <button class="theme-toggle" type="button" data-action="theme#toggle" aria-label="Activer le thème sombre" aria-pressed="false" title="Changer de thème"><span data-theme-icon aria-hidden="true">☾</span><span>Changer de thème</span></button>
      </section>{% endif %}
    </section>
  </div>
  </turbo-frame>
</main>
</body></html>
